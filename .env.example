# Copy to .env.local and fill with this demo's Supabase public configuration.
# Never put a service-role key or a Groq secret in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable only after Google is configured in Supabase. Desktop OAuth handoff is separate.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
# The current demo uses confirmation links, not numeric email codes.
NEXT_PUBLIC_EMAIL_OTP_ENABLED=false

# Server-only billing configuration. Never expose these with NEXT_PUBLIC_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
