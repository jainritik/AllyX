# Copy to .env.local and fill with this demo's Supabase public configuration.
# Never put a service-role key or a Groq secret in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Configure Google in Supabase before publishing. The app presents Google OAuth
# alongside email one-time codes, so these legacy feature flags are intentionally
# not used.

# Server-only billing configuration. Never expose these with NEXT_PUBLIC_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Optional permanent, account-bound ₹1 live checkout testing price (server-only)
ALLYX_LIVE_PAYMENT_VALIDATION_USER_ID=

# Optional Deepgram streaming trial, server-only. Never use NEXT_PUBLIC_.
DEEPGRAM_LIVE_ENABLED=false
DEEPGRAM_API_KEY=
# Comma-separated Supabase auth user IDs, or * for all signed-in active sessions; empty disables access.
DEEPGRAM_TRIAL_USER_IDS=
